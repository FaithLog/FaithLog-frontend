EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_MOCK_MODE=false
EXPO_PUBLIC_ANNOUNCEMENTS_ENABLED=true
EXPO_PUBLIC_ANNOUNCEMENT_PDF_ENABLED=false
